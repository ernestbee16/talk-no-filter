datasource db {
  // Use "sqlite" for local offline testing or "postgresql" for cloud deployment (Render/Railway/Supabase/Neon)
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(cuid())
  phone        String        @unique
  displayName  String? // optional, not required for anonymity
  createdAt    DateTime      @default(now())
  wallet       Wallet?
  bookings     Booking[]
  subscription Subscription?
}

model Expert {
  id           String             @id @default(cuid())
  name         String
  specialty    String
  verified     Boolean            @default(false)
  availability AvailabilitySlot[]
}

model AvailabilitySlot {
  id        String   @id @default(cuid())
  expertId  String
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)
  expert    Expert   @relation(fields: [expertId], references: [id])
}

model Booking {
  id           String   @id @default(cuid())
  userId       String
  slotId       String
  serviceType  String // "quick_check" | "standard" | "gold_credit" | "platinum_credit"
  status       String // "pending_payment" | "confirmed" | "completed" | "cancelled"
  videoRoomUrl String?
  notesEnc     String? // encrypted consultation notes (AES-256-GCM)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model Wallet {
  id             String @id @default(cuid())
  userId         String @unique
  sessionCredits Int    @default(0)
  minuteBalance  Int    @default(0)
  user           User   @relation(fields: [userId], references: [id])
}

model Subscription {
  id       String   @id @default(cuid())
  userId   String   @unique
  plan     String // "platinum"
  status   String // "active" | "past_due" | "cancelled"
  renewsAt DateTime
  user     User     @relation(fields: [userId], references: [id])
}

model AnonymousQuestion {
  id          String    @id @default(cuid())
  contentEnc  String // encrypted question text (AES-256-GCM)
  status      String // "pending" | "answered" | "published"
  answerEnc   String? // encrypted answer text (AES-256-GCM)
  submittedAt DateTime  @default(now())
  publishedAt DateTime?
}

model Webinar {
  id            String                @id @default(cuid())
  title         String
  description   String
  scheduledAt   DateTime
  recordingUrl  String?
  registrations WebinarRegistration[]
}

model WebinarRegistration {
  id        String  @id @default(cuid())
  webinarId String
  phone     String
  webinar   Webinar @relation(fields: [webinarId], references: [id])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  amount      Int // in RWF
  provider    String // "mtn_momo" | "airtel_money" | "card"
  reference   String   @unique
  status      String // "pending" | "success" | "failed"
  serviceType String // "quick_check" | "standard" | "gold_bundle" | "platinum_sub"
  slotId      String? // link to slot if booking
  createdAt   DateTime @default(now())
}

model MythFact {
  id             String    @id @default(cuid())
  claim          String // the myth/social-media claim being addressed
  verifiedFact   String // the sourced correction
  sourceName     String // e.g. "WHO", "Rwanda Biomedical Centre", expert name
  sourceUrl      String?
  authorExpertId String?
  status         String // "draft" | "published"
  viewCount      Int       @default(0)
  shareCount     Int       @default(0)
  submittedFrom  String? // optional link back to a user-submitted claim
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
}
